{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "ZaramaGYM",
  "version": "0.1.0",
  "identifier": "com.zaramagym.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ZaramaGYM - Sistema de Gestión",
        "width": 1280,
        "height": 800,
        "minWidth": 560,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0MjM4Mzg4NjVCMDc2ODIKUldTQ2RyQmxpSU1qSkFwRGlNZUdKY3J1cXdYK1d2YnNNcVBTaWUwQzExQmJyTXJzTUU3UDdRZ0QK",
      "endpoints": [
        "https://github.com/elmarv05/ZaramaGYM/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
